{
  "name": "@postern/daemon",
  "version": "0.0.0",
  "private": true,
  "description": "Local backend service. Runs the protocol, storage, and AI layers and exposes them to the UI over a loopback HTTP API. Bundled as a Tauri sidecar.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --packages=bundle --external:jsdom --outfile=dist/daemon.cjs",
    "start": "node dist/daemon.cjs",
    "dev": "pnpm run build && node dist/daemon.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@postern/ai": "workspace:^",
    "@postern/core": "workspace:^",
    "@postern/protocol": "workspace:^",
    "@postern/utils": "workspace:^",
    "jsdom": "^29.1.1"
  },
  "devDependencies": {
    "@postern/tsconfig": "workspace:^",
    "@types/jsdom": "^28.0.3",
    "@types/node": "24.12.4",
    "esbuild": "^0.25.0"
  }
}
